// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum CampaignType {
  STORE
  ECOMMERCE
  SMS
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  PAUSED
}

model Store {
  id        Int      @id
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("stores")
}

model Campaign {
  id                  String         @id @default(cuid())
  name                String
  type                CampaignType   @default(STORE)
  status              CampaignStatus @default(DRAFT)
  subject             String?
  participatingStores String[]       @default([])
  budget              String?
  startDate           DateTime?
  endDate             DateTime?
  content             String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaigns")
}

/// ADMIN can create, edit and delete campaigns; VIEWER can only view them.
enum Role {
  ADMIN
  VIEWER
}

model User {
  userId   String @id @default(uuid()) @db.Uuid
  userName String @unique
  password String
  role     Role   @default(VIEWER)

  // Profile (all optional, edited on /profile)
  fullName String?
  email    String?
  jobTitle String?
  company  String?
  bio      String? @db.Text

  // Avatar: a 256×256 image resized in the browser, served by /api/avatar/[userId]
  avatar          Bytes?
  avatarType      String?
  avatarUpdatedAt DateTime?

  // Presence: last time the user had the app open (page load or a once-a-minute ping, see
  // app/lib/presence.ts). Written with raw SQL so it doesn't bump updatedAt.
  lastSeenAt DateTime?

  // Alerts the user subscribed to, and the notifications they produced (app/lib/alerts)
  alertRules    AlertRule[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// What an alert watches. Settings per type live in AlertRule.params (see app/lib/alerts/types.ts).
enum AlertType {
  SALES_DROP
  OUT_OF_STOCK
  CAMPAIGN
}

/// One alert a user subscribed to ("tell me when …").
model AlertRule {
  id     String    @id @default(cuid())
  userId String    @db.Uuid
  user   User      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type   AlertType
  params Json
  active Boolean   @default(true)

  states        AlertState[]
  notifications Notification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("alert_rules")
}

/// What a rule has already reported, so the same thing isn't sent again (cooldown / dedupe).
model AlertState {
  id          String    @id @default(cuid())
  ruleId      String
  rule        AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  subjectKey  String // e.g. "18:254440" (store:article) or "18:yesterday:2026-10-01"
  lastFiredAt DateTime  @default(now())

  @@unique([ruleId, subjectKey])
  @@map("alert_states")
}

/// A message in someone's bell. Stored as data (kind + data), turned into text in the reader's language.
model Notification {
  id        String     @id @default(cuid())
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  ruleId    String?
  rule      AlertRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  kind      String
  data      Json
  readAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}