// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum CampaignType {
  STORE
  ECOMMERCE
  SMS
  EMAIL
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  PAUSED
}

model Store {
  id        Int      @id
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("stores")
}

model Campaign {
  id                  String         @id @default(cuid())
  name                String
  type                CampaignType   @default(STORE)
  status              CampaignStatus @default(DRAFT)
  subject             String?
  participatingStores String[]       @default([])
  budget              String?
  startDate           DateTime?
  endDate             DateTime?
  content             String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("campaigns")
}

model User {
  userId   String @id @default(uuid()) @db.Uuid
  userName String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}